<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.stress_detekt.fragments.DashboardFragment"
        android:label="Dashboard" />

    <fragment
        android:id="@+id/terminalFragment"
        android:name="com.stress_detekt.fragments.TerminalFragment"
        android:label="Terminal">
        <action
            android:id="@+id/action_terminal_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/resultsFragment"
        android:name="com.stress_detekt.fragments.ResultsFragment"
        android:label="Results" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.stress_detekt.fragments.SettingsFragment"
        android:label="Settings" />

</navigation>